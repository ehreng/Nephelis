{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Progress",
  "type": "object",
  "required": [
    "updated_at",
    "headline",
    "phase",
    "next_engineering_milestone",
    "launch_posture",
    "budget_posture",
    "built",
    "not_yet",
    "team",
    "repos"
  ],
  "properties": {
    "updated_at": { "type": "string" },
    "headline": { "type": "string" },
    "phase": { "type": "string" },
    "next_engineering_milestone": { "type": "string" },
    "launch_posture": { "type": "object" },
    "budget_posture": { "type": "object" },
    "built": { "type": "array" },
    "not_yet": { "type": "array" },
    "team": { "type": "object" },
    "repos": { "type": "array" }
  }
}
