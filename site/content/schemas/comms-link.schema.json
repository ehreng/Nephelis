{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CommsLink",
  "type": "object",
  "required": [
    "updated_at",
    "version",
    "status",
    "architecture",
    "probe_to_relay",
    "relay_to_earth",
    "daily_return_mb",
    "products"
  ],
  "properties": {
    "updated_at": { "type": "string" },
    "version": { "type": "string" },
    "status": { "type": "string" },
    "notes": { "type": "string" },
    "architecture": { "type": "object" },
    "probe_to_relay": {
      "type": "object",
      "required": ["band", "rate_kbps_typ"],
      "properties": {
        "band": { "type": "string" },
        "rate_kbps_typ": { "type": "number" },
        "rate_kbps_range": { "type": "array", "items": { "type": "number" } },
        "contacts_per_day_typ": { "type": "number" },
        "contact_min_typ": { "type": "number" },
        "heritage": { "type": "string" }
      }
    },
    "relay_to_earth": {
      "type": "object",
      "required": ["band", "rate_kbps_typical"],
      "properties": {
        "band": { "type": "string" },
        "heritage": { "type": "string" },
        "ground": { "type": "string" },
        "rate_kbps_far": { "type": "number" },
        "rate_kbps_typical": { "type": "number" },
        "rate_kbps_close": { "type": "number" },
        "pass_min_far": { "type": "number" },
        "pass_min_typical": { "type": "number" },
        "pass_min_close": { "type": "number" },
        "range_au": { "type": "object" },
        "conjunction_note": { "type": "string" }
      }
    },
    "daily_return_mb": {
      "type": "object",
      "required": ["far", "typical", "close"],
      "properties": {
        "far": { "type": "number" },
        "typical": { "type": "number" },
        "close": { "type": "number" },
        "notes": { "type": "string" }
      }
    },
    "queue": { "type": "array", "items": { "type": "string" } },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "size_mb", "priority"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "size_mb": { "type": "number", "minimum": 0 },
          "priority": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
